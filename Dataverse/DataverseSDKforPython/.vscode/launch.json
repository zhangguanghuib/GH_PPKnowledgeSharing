{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug bulk availability (account)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build SearchforDataverserecords",
      "program": "${workspaceFolder}/SearchforDataverserecords/bin/Debug/net8.0/SearchforDataverserecords.dll",
      "cwd": "${workspaceFolder}/SearchforDataverserecords",
      "args": [
        "bulk-availability",
        "account"
      ],
      "console": "integratedTerminal",
      "stopAtEntry": true
    },
    {
      "name": "Debug deleted accounts (FetchXML)",
